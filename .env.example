# Copy to .env (never commit .env). Only the Gatekeeper reads secrets; agents never do.

# Arc testnet. Use your QuickNode HTTPS endpoint, or the public RPC as a fallback.
ARC_RPC_URL=https://rpc.testnet.arc.network
# Log queries (eth_getLogs). QuickNode's free plan caps these at 5 blocks, so default is Arc's public RPC.
# ARC_LOGS_RPC_URL=

# Phase 5 — Auto-Shield (defaults shown)
# KARUNA_SHIELD_TESTS_PER_DAY=2
# KARUNA_SHIELD_WINDOW_MINUTES=30
# Pre-flight: three Drills for each new agent; one nobody acted on passes after this long
# KARUNA_PREFLIGHT_MINUTES=5
# KARUNA_PREFLIGHT=0   turns the automatic pre-flight off (Run again on the agent card still works)

# Phase 6 — Swarm Stopper (defaults shown): this many agents on one new target within the window → freeze all
# KARUNA_SWARM_AGENTS=2
# KARUNA_SWARM_WINDOW_SECONDS=60

# Phase 4 — QuickNode Stream → relay (see docs/QUICKNODE.md). Secrets: never commit .env.
# QUICKNODE_API_KEY=
# RELAY_PUBLIC_URL=https://….trycloudflare.com
# QUICKNODE_SECURITY_TOKEN=   (generated by `pnpm --dir relay stream:create`)
ARC_WS_URL=wss://rpc.testnet.arc.network

# Where the Gatekeeper keeps its org config, state, and signed log (default gatekeeper/data).
# KARUNA_DATA_DIR=

# Ports (defaults shown). The agent API is what agents call; the console API is localhost-only.
# KARUNA_AGENT_PORT=8787
# KARUNA_CONSOLE_PORT=8788

# Deployer key for the Dharma contract (Phase 3). A throwaway testnet key, never a real one.
DEPLOYER_PRIVATE_KEY=

# Fast relayer: a plain key (holding only test USDC for gas) that delivers members' signed proposals,
# votes and executions to Arc in ~1s instead of through the Circle wallet (minutes). It can't change
# anything members didn't sign. Fund it with a little test USDC; without it, every write uses the Circle wallet.
# KARUNA_RELAYER_KEY=0x…

# Karuna Voice (ElevenLabs): talk to the island, and hear held requests and votes read aloud.
# The key stays on the Gatekeeper; the desktop app only gets one-time conversation tokens and audio.
# 1. ELEVENLABS_API_KEY from elevenlabs.io → Developers → API keys
# 2. ELEVENLABS_VOICE_ID: any voice from elevenlabs.io → Voices (copy its ID); used for spoken alerts
# 3. pnpm --dir gatekeeper voice:agent  → prints ELEVENLABS_AGENT_ID to add here
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
