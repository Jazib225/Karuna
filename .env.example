# Copy to .env (never commit .env). Only the Gatekeeper reads secrets; agents never do.

# Arc testnet. Use your QuickNode HTTPS endpoint, or the public RPC as a fallback.
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_WS_URL=wss://rpc.testnet.arc.network

# The bakery's Circle Agent Wallet address (public; from `circle wallet list --type agent`)
BAKERY_WALLET_ADDRESS=

# Deployer key for the Dharma contract (Phase 3). A throwaway testnet key, never a real one.
DEPLOYER_PRIVATE_KEY=
