{
  "name": "@prekaruna/gatekeeper",
  "private": true,
  "type": "module",
  "description": "Karuna Gatekeeper: the only process that holds wallet access. Agents propose; it decides, pays, and logs.",
  "scripts": {
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "verify:phase2": "tsx scripts/verify-phase2.ts",
    "verify:phase3": "tsx scripts/verify-phase3.ts",
    "verify:phase5": "tsx scripts/verify-phase5.ts",
    "verify:phase6": "tsx scripts/verify-phase6.ts",
    "demo": "tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit -p .",
    "voice:agent": "tsx scripts/voice-agent.ts",
    "voice:sounds": "tsx scripts/voice-sounds.ts",
    "dev": "tsx watch --clear-screen=false src/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@prekaruna/dharma": "workspace:*",
    "@prekaruna/engine": "workspace:*",
    "dotenv": "^18.0.10",
    "node-forge": "1.3.1",
    "viem": "2.57.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/node-forge": "1.3.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
